let i = 0;
let limit = 1000000;
let a = 100;
let b = 3;
let result = 0;

while (i < limit) {
    result = a + b;
    result = a - b;
    result = a * b;
    result = a / b;
    if (a == result) {
        result = result + 1;
    } else {
        result = result - 1;
    }
    i = i + 1;
}

print result;
